<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- A finished download can live in several places; FileProvider throws
         "Failed to find configured root that contains ..." for anything outside
         these roots, which made the notification Open button do nothing. -->
    <external-path name="external_files" path="."/>
    <external-files-path name="external_files_dir" path="."/>
    <external-cache-path name="external_cache" path="."/>
    <files-path name="internal_files" path="."/>
    <cache-path name="internal_cache" path="."/>
    <files-path name="updates" path=".abdm/system/update/downloads"/>
</paths>
